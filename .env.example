# 默认只在本机访问。复制为 .env 后修改；不要将 .env 提交或分享。
QUANT_HOST=127.0.0.1
QUANT_PORT=8765
QUANT_DB_PATH=data/quant.db
# 服务器访问必须设置至少十二位口令，并列出访问域名；不带协议或端口。
CONSOLE_PASSWORD=
CONSOLE_ALLOWED_HOSTS=
# 测试网专用密钥，与真实账户密钥分开。
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
# 实盘只有明确开启后才允许启动；本项目交付时不配置真实资金。
ENABLE_LIVE_TRADING=false
BINANCE_API_KEY=
BINANCE_API_SECRET=
